@model IEnumerable<ProjectRempakTani.Models.Produk>

@{
    ViewData["Title"] = "Data Produk";
}

<h2 class="mb-3">Data Produk</h2>

<a asp-action="Create" class="btn btn-warning mb-3 text-white"><i class="bi bi-plus-circle"></i> Tambah Produk</a>

<table class="table table-bordered table-striped">
    <thead class="table-warning">
        <tr>
            <th>Nama Produk</th>
            <th>Kategori</th>
            <th>Harga</th>
            <th>Stok</th>
            <th>Aksi</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NamaProduk</td>
                <td>@item.Kategori?.NamaKategori</td>
                <td>@item.Harga.ToString("C")</td>
                <td>@item.Stok</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detail</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Hapus</a>
                </td>
            </tr>
        }
    </tbody>
</table>
