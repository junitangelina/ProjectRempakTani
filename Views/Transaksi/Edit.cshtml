@model ProjectRempakTani.ViewModels.TransaksiViewModel

@{
    ViewData["Title"] = "Edit Transaksi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit Transaksi</h2>

<form asp-action="Edit" asp-route-id="@ViewBag.TransaksiId" method="post">
    <div class="mb-3">
        <label asp-for="TanggalTransaksi" class="form-label"></label>
        <input asp-for="TanggalTransaksi" class="form-control" />
        <span asp-validation-for="TanggalTransaksi" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Keterangan" class="form-label"></label>
        <input asp-for="Keterangan" class="form-control" />
        <span asp-validation-for="Keterangan" class="text-danger"></span>
    </div>

    <h5>Daftar Produk</h5>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nama Produk</th>
                <th>Harga Satuan</th>
                <th>Jumlah</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>@Model.Items[i].NamaProduk</td>
                    <td>
                        <input asp-for="Items[i].HargaSatuan" class="form-control" readonly />
                    </td>
                    <td>
                        <input asp-for="Items[i].Jumlah" class="form-control" />
                        <input type="hidden" asp-for="Items[i].ProdukId" />
                        <input type="hidden" asp-for="Items[i].NamaProduk" />
                    </td>
                    <td>@(Model.Items[i].Jumlah * Model.Items[i].HargaSatuan)</td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
    <a asp-action="Index" class="btn btn-secondary">Batal</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
