@model ProjectRempakTani.Models.Transaksi

@{
    ViewData["Title"] = "Hapus Transaksi";
}

<h2>Hapus Transaksi</h2>

<h4>Yakin ingin menghapus transaksi ini?</h4>

<div class="mb-3">
    <strong>Tanggal:</strong> @Model.TanggalTransaksi <br />
    <strong>Keterangan:</strong> @Model.Keterangan
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Hapus</button>
    <a asp-action="Index" class="btn btn-secondary">Batal</a>
</form>
