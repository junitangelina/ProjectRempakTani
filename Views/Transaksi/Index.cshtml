@model IEnumerable<ProjectRempakTani.Models.Transaksi>

@{
    ViewData["Title"] = "Daftar Transaksi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var search = Context.Request.Query["search"].ToString(); // <- tambahkan baris ini
}

<h2>Daftar Transaksi</h2>

<a asp-action="Create" class="btn btn-warning mb-3 text-white"><i class="bi bi-plus-circle"></i> Tambah Transaksi</a>
<form asp-action="Index" method="get" class="mb-3 d-flex">
    <input type="text" name="search" class="form-control me-2" placeholder="Cari berdasarkan keterangan..." value="@Context.Request.Query["search"]" />
    <button type="submit" class="btn btn-outline-secondary">Cari</button>
</form>
<table class="table table-bordered table-striped">
    <thead class="table-warning">
        <tr>
            <th>Tanggal</th>
            <th>Keterangan</th>
            <th>Total Item</th>
            <th>Total Harga</th>
            <th>Aksi</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var transaksi in Model)
        {
            var totalHarga = transaksi.DetailTransaksis.Sum(d => d.HargaSatuan * d.Jumlah);
            var totalItem = transaksi.DetailTransaksis.Sum(d => d.Jumlah);

            <tr>
                <td>@transaksi.TanggalTransaksi.ToShortDateString()</td>
                <td>@transaksi.Keterangan</td>
                <td>@totalItem</td>
                <td>Rp @totalHarga.ToString("N0")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@transaksi.Id" class="btn btn-sm btn-warning text-white">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@transaksi.Id" class="btn btn-sm btn-secondary">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@transaksi.Id" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>

            
            </tr>
        }
    </tbody>
</table>
