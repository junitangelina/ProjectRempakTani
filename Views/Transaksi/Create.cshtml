@model ProjectRempakTani.ViewModels.TransaksiViewModel

@{
    ViewData["Title"] = "Buat Transaksi";
}

<h2>Buat Transaksi</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="TanggalTransaksi" class="form-label"></label>
        <input asp-for="TanggalTransaksi" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Keterangan" class="form-label"></label>
        <input asp-for="Keterangan" class="form-control" />
    </div>

    <h4>Detail Produk</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Produk</th>
                <th>Harga</th>
                <th>Jumlah</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        @Model.Items[i].NamaProduk
                        <input type="hidden" asp-for="Items[@i].ProdukId" />
                        <input type="hidden" asp-for="Items[@i].NamaProduk" />
                    </td>
                    <td>
                        <input asp-for="Items[@i].HargaSatuan" class="form-control" readonly />
                    </td>
                    <td>
                        <input asp-for="Items[@i].Jumlah" class="form-control" />
                    </td>
                    <td>
                        @(Model.Items[i].HargaSatuan * Model.Items[i].Jumlah)
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-warning">Simpan Transaksi</button>
</form>
