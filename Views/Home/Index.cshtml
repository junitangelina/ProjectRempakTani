@{
    Layout = null;
    ViewData["Title"] = "Welcome - Rempak Tani";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

    <style>
        body {
            background: url('/images/background-account.png') no-repeat center center fixed;
            background-size: cover;
            height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Poppins', sans-serif;
        }

        .welcome-box {
            background: rgba(255, 255, 255, 0.92);
            border-radius: 20px;
            padding: 50px 40px;
            text-align: center;
            box-shadow: 0 12px 30px rgba(0,0,0,0.1);
            max-width: 480px;
            width: 100%;
        }


        .welcome-icon {
            font-size: 2.5rem;
            color: #FCC43E;
            margin-bottom: 10px;
        }

        .welcome-box h1 {
            font-size: 1.8rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .welcome-box p {
            color: #6c757d;
            font-size: 1rem;
            margin-bottom: 30px;
        }

        .btn-custom {
            background-color: #FCC43E;
            color: #fff;
            padding: 10px 28px;
            font-size: 1rem;
            border-radius: 30px;
            margin: 0 10px;
            border: none;
            transition: 0.3s ease;
        }

            .btn-custom:hover {
                background-color: #e5b733;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .btn-outline-custom {
            color: #FCC43E;
            border: 2px solid #FCC43E;
            background-color: transparent;
            padding: 10px 28px;
            font-size: 1rem;
            border-radius: 30px;
            margin: 0 10px;
            transition: 0.3s ease;
        }

            .btn-outline-custom:hover {
                background-color: #FCC43E;
                color: white;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>
    <div class="welcome-box">
        <img src="/images/logo-rempak-tani.png" alt="Logo Rempak Tani" class="logo" />
        <h1>Selamat Datang</h1>
        <p>Silakan login untuk mengakses sistem</p>
        <a href="/Account/Login" class="btn btn-custom">Login</a>
        <a href="/Account/Register" class="btn btn-outline-custom">Register</a>
    </div>
</body>
</html>
