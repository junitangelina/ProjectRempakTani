@model ProjectRempakTani.Models.Inventory

@{
    ViewData["Title"] = "Edit Barang";
}

<div class="container mt-4">
    <h2>Edit Barang</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label>Nama Barang</label>
            <input asp-for="NamaBarang" class="form-control" />
        </div>
        <div class="form-group">
            <label>Kategori</label>
            <input asp-for="Kategori" class="form-control" />
        </div>
        <div class="form-group">
            <label>Jumlah</label>
            <input asp-for="Jumlah" class="form-control" type="number" />
        </div>
        <div class="form-group">
            <label>Lokasi</label>
            <input asp-for="Lokasi" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Update</button>
        <a href="/Inventory" class="btn btn-secondary">Batal</a>
    </form>
</div>
