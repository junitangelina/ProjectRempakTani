<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectRempakTani</title>

    <!-- Bootstrap & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom Style -->
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
        }

        .sidebar {
            height: 100vh;
            width: 250px;
            background-color: #FFD966;
            padding: 1.5rem 1rem;
            position: fixed;
        }

            .sidebar .nav-link {
                color: #000;
                font-weight: 600;
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .sidebar .nav-link:hover {
                    background-color: #fff3cd;
                    border-radius: 8px;
                    padding-left: 10px;
                }

        .main-content {
            margin-left: 250px;
            padding: 2rem;
        }

        header {
            background-color: #fff;
            padding: 1rem 2rem;
            border-bottom: 2px solid #dee2e6;
        }

        footer {
            padding: 1rem 2rem;
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar d-flex flex-column justify-content-between">
            <div>
                <div class="text-center mb-4">
                    <img src="~/images/logo-rempak-tani.png" width="80" alt="Logo" class="mb-2" />
                    <h5>Rempak Tani</h5>
                </div>
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-chart-line"></i> Dashboard
                </a>
                <a class="nav-link" asp-controller="Produk" asp-action="Index">
                    <i class="fas fa-box"></i> Data Produk
                </a>
                <a class="nav-link" asp-controller="Transaksi" asp-action="Index">
                    <i class="fas fa-exchange-alt"></i> Data Transaksi
                </a>
                <a class="nav-link" asp-controller="DetailTransaksi" asp-action="Index">
                    <i class="fas fa-receipt"></i> Detail Transaksi
                </a>
            </div>

            <!-- Logout -->
            <div>
                <!-- Logout -->
                <div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2" type="submit">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </button>
                    </form>
                </div>

            </div>
        </nav>

        <!-- Main Content -->
        <div class="flex-grow-1 main-content">
            <header class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <span>Halo, @User.Identity?.Name</span>
            </header>

            <div class="content mt-4">
                @RenderBody()
            </div>

            <footer class="mt-4">
                &copy; 2025 - ProjectRempakTani
            </footer>
        </div>
    </div>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
 
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
