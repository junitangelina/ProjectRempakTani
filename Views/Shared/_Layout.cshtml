<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rempak Tani</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectRempakTani.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <!-- Layout Container -->
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block" style="background-color: #fffdf3; min-height: 100vh; border-right: 1px solid #eee;">
                <div class="d-flex flex-column p-3" style="height: 100%;">
                    <!-- Logo & Title -->
                    <div class="text-center mb-4">
                        <img src="~/images/logo-rempak-tani.png" alt="Logo" width="80" class="mb-2" />
                        <h5 class="fw-bold text-warning">Rempak Tani</h5>
                    </div>

                    <!-- Menu -->
                    <div class="fw-bold text-muted small mb-2">MENU</div>
                    <ul class="nav flex-column mb-auto">
                        <li class="nav-item mb-1">
                            <a class="nav-link d-flex align-items-center text-dark" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2 text-warning"></i>Dashboard
                            </a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item mb-1">
                                <a class="nav-link d-flex align-items-center text-dark" data-bs-toggle="collapse" href="#inventorySubmenu" role="button" aria-expanded="false" aria-controls="inventorySubmenu">
                                    <i class="bi bi-boxes me-2 text-warning"></i>Inventory
                                </a>
                                <div class="collapse ps-4" id="inventorySubmenu">
                                    <ul class="nav flex-column">
                                        <li class="nav-item mb-1">
                                            <a class="nav-link text-dark" asp-controller="Kategoris" asp-action="Index">
                                                <i class="bi bi-cart me-2 text-warning"></i>Kategori
                                            </a>
                                        </li>
                                        <li class="nav-item mb-1">
                                            <a class="nav-link text-dark" asp-controller="Produk" asp-action="Index">
                                                <i class="bi bi-box me-2 text-warning"></i>Data Produk
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li class="nav-item mb-1">
                                <a class="nav-link d-flex align-items-center text-dark" asp-controller="Transaksi" asp-action="Index">
                                    <i class="bi bi-cart-check me-2 text-warning"></i>Transaksi
                                </a>
                            </li>
                        }
                        <li class="nav-item mb-1">
                            <a class="nav-link d-flex align-items-center text-dark" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock me-2 text-warning"></i>Privacy
                            </a>
                        </li>

                        <!-- Logout -->
                        <li class="nav-item mt-4">
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="py-4">
                    <!-- Breadcrumb -->
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb px-3 py-2 rounded shadow-sm" style="background-color: #fff9e6;">
                            <li class="breadcrumb-item">
                                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark">
                                    <i class="bi bi-house-door me-1"></i>Home
                                </a>
                            </li>
                            <li class="breadcrumb-item active text-dark" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>

                    <div class="bg-white rounded shadow-sm p-4">
                        @RenderBody()
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-top text-muted py-3">
        <div class="container text-center small">
            &copy; 2025 - Rempak Tani - <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Privacy</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
