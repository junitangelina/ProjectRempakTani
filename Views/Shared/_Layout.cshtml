<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rempak Tani</title>

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" />

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectRempakTani.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <!-- Navbar Top -->
    <nav class="navbar navbar-expand-lg shadow-sm sticky-top" style="background-color: #FCC43E;">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold fs-4 text-white" asp-controller="Home" asp-action="Index">
                <i class="bi bi-tree-fill me-2"></i>Rempak Tani
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Home" asp-action="Privacy">
                            <i class="bi bi-shield-lock me-1"></i>Privacy
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Transaksi" asp-action="Transaksi">
                            <i class="bi bi-shield-lock me-1"></i>Transaksi
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Produk" asp-action="Index">
                                <i class="bi bi-box-seam me-1"></i>Produk
                            </a>
                        <li class="nav-item mb-1">
                            <a class="nav-link d-flex align-items-center text-dark" asp-controller="Transaksi" asp-action="Index">
                                <i class="bi bi-cart-check me-2" style="color: #e0b935;"></i>Transaksi
                            </a>
                        </li>
                        </li>
                    }
                </ul>
                <div class="d-flex">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>

    <!-- Page Layout -->
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block" style="background-color: #fffdf3; min-height: calc(100vh - 56px); border-right: 1px solid #eee;">
                <div class="p-3">
                    <div class="fw-bold text-muted small mb-3">MENU</div>
                    <ul class="nav flex-column">
                        <li class="nav-item mb-1">
                            <a class="nav-link d-flex align-items-center text-dark" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2" style="color: #FCC43E;"></i>Dashboard
                            </a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item mb-1">
                                <a class="nav-link d-flex align-items-center text-dark" asp-controller="" asp-action="Index">
                                    <i class="bi bi-boxes me-2" style="color: #e0b935;"></i>Inventory
                                </a>
                            </li>
                        }
                        <li class="nav-item mb-1">
                            <a class="nav-link d-flex align-items-center text-dark" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock me-2" style="color: #eabf20;"></i>Privacy
                            </a>
                        </li>
                   
                        <li class="nav-item mb-1">
                            <a class="nav-link d-flex align-items-center text-dark" asp-controller="Kategoris" asp-action="Index">
                                <i class="bi bi-cart-check me-2" style="color: #e0b935;"></i>Kategori
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link d-flex align-items-center text-dark" asp-controller="Produk" asp-action="Index">
                                <i class="bi bi-cart-check me-2" style="color: #e0b935;"></i>Data Produk
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link d-flex align-items-center text-dark" asp-controller="Transaksi" asp-action="Index">
                                <i class="bi bi-cart-check me-2" style="color: #e0b935;"></i>Transaksi
                            </a>
                        </li>
                     
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="py-4">
                    <!-- Breadcrumb -->
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb px-3 py-2 rounded shadow-sm" style="background-color: #fff9e6;">
                            <li class="breadcrumb-item">
                                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark">
                                    <i class="bi bi-house-door me-1"></i>Home
                                </a>
                            </li>
                            <li class="breadcrumb-item active text-dark" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>

                    <!-- Render Body -->
                    <div class="bg-white rounded shadow-sm p-4">
                        @RenderBody()
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-top text-muted py-3">
        <div class="container text-center small">
            &copy; 2025 - Rempak Tani - <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Privacy</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)





    <!-- Style Customization -->
    <style>
        .sidebar .nav-link:hover {
            background-color: #fff8dc;
            border-radius: 0.375rem;
            transition: all 0.2s ease;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            content: "›";
            font-weight: bold;
        }
    </style>
</body>
</html>